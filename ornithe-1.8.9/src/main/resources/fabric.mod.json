{
	"schemaVersion": 1,
	"id": "obs_rec_indicator",
	"version": "${version}",
	"name": "OBS Rec Indicator",
	"description": "Shows an in-game recording indicator driven by OBS Studio WebSocket 5.x.",
	"authors": [
		"OBS Rec Indicator contributors"
	],
	"license": "LGPL-3.0-only",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.obsindicator.client.ObsRecIndicatorClient"
		]
	},
	"mixins": [
		{
			"config": "obs_rec_indicator.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.12.0",
		"minecraft": "1.8.9",
		"java": ">=21",
		"oneconfigv1": "*"
	}
}
